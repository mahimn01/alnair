#!/usr/bin/env python3
"""clp-rune: Alnair in Rune. See claude-mem/rune/README.md (symlinked into ~/.local/bin by `clp-rune install`)."""

import os
import sys

_here = os.path.dirname(os.path.realpath(__file__))
sys.path.insert(0, os.path.join(os.path.dirname(_here)))  # package dir lives next to bin/

from clprune.cli import main  # noqa: E402

if __name__ == "__main__":
    raise SystemExit(main(sys.argv[1:], prog=os.path.basename(sys.argv[0])))
